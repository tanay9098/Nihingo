# ---- FalkorDB (server-side only; never sent to the browser) ----
FALKORDB_HOST=localhost
# If 6379 is already in use (another Redis/FalkorDB container), run FalkorDB on 6380 instead
# (docker run -p 6380:6379 ...) and set FALKORDB_PORT=6380.
FALKORDB_PORT=6379
# Leave empty for a local, unauthenticated dev database. In docker-compose this is passed to
# FalkorDB as REDIS_ARGS="--requirepass ...". Use a real secret for anything exposed beyond localhost.
FALKORDB_PASSWORD=
FALKORDB_GRAPH=nihongo

# ---- App ----
# If 3001 is already in use, pick another port, e.g. PORT=3002 (then open http://localhost:3002).
PORT=3001
# Set to 0 to skip auto-initialisation / auto-ingestion / demo seeding on boot.
AUTO_BOOTSTRAP=1

# ---- AI mode (optional). Without a key the app runs in deterministic DEMO mode. ----
# LLM_PROVIDER: anthropic | openai  (openai also covers any OpenAI-compatible endpoint via LLM_BASE_URL)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---- Optional GraphRAG-SDK sidecar (Python, see graphrag/README.md) ----
GRAPHRAG_URL=

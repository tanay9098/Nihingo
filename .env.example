# ---- FalkorDB (server-side only; never sent to the browser) ----
FALKORDB_HOST=localhost
# Host port FalkorDB is published on (docker run -p 6380:6379 ...).
FALKORDB_PORT=6380
# Leave empty for a local, unauthenticated dev database. In docker-compose this is passed to
# FalkorDB as REDIS_ARGS="--requirepass ...". Use a real secret for anything exposed beyond localhost.
FALKORDB_PASSWORD=
# Optional ACL user name (some hosted databases need one). Leave empty for the default user.
FALKORDB_USERNAME=
# Set to 1 to connect over TLS (e.g. FalkorDB Cloud). Leave 0 for the bundled plain-TCP database.
FALKORDB_TLS=0
FALKORDB_GRAPH=nihongo

# ---- App ----
# App port (open http://localhost:3002).
PORT=3002
# Set to 0 to skip auto-initialisation / auto-ingestion / demo seeding on boot.
AUTO_BOOTSTRAP=1
# Set to 1 behind a reverse proxy (Render, Fly, nginx, …) so client IPs and https are read from X-Forwarded-* headers.
TRUST_PROXY=0

# ---- Learner accounts ----
# How long a sign-in lasts.
SESSION_TTL_DAYS=30
# Set to 1 when the app is served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=0
# A guest account (no sign-in, kept in this browser's cookie) is deleted after this many days without use.
GUEST_TTL_DAYS=180
# Legacy email + password endpoints. Off: sign-in is with Google (or as a guest).
PASSWORD_AUTH=0

# ---- Sign in with Google (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application") ----
# Without both values the "Continue with Google" button is hidden; guest accounts still work.
GOOGLE_CLIENT_ID=
# Secret: server-side only, never sent to the browser.
GOOGLE_CLIENT_SECRET=
# Must be listed exactly under "Authorized redirect URIs" of the OAuth client.
# Empty = derived from the request: http://localhost:3002/api/auth/google/callback locally.
GOOGLE_REDIRECT_URI=

# ---- AI mode (optional). Without a key the app runs in deterministic DEMO mode. ----
# LLM_PROVIDER: anthropic | openai  (openai also covers any OpenAI-compatible endpoint via LLM_BASE_URL)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---- Optional GraphRAG-SDK sidecar (Python, see graphrag/README.md) ----
GRAPHRAG_URL=

{
  "name": "nihongo-graph",
  "version": "1.0.0",
  "description": "Graph-powered Japanese learning companion: persistent FalkorDB memory + three coordinated agents.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
